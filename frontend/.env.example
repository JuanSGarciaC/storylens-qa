# Base de la API que usa el frontend (se lee al compilar con Vite).
# Por defecto "/api/v1" (el proxy de desarrollo la reenvía al backend). Déjala así.
#
# IMPORTANTE: el login del dueño exige MISMO ORIGEN (frontend y API bajo el mismo
# dominio): el cliente envía credenciales "same-origin", el backend no activa
# allow_credentials y la cookie es SameSite=Lax. Con una URL absoluta de otro
# dominio solo funciona la demo anónima; el login no. Para un hosting estático,
# reenvía /api/v1/* al backend con un rewrite/proxy del propio host.
# No incluyas secretos: todo lo que empieza por VITE_ queda público en el bundle.
VITE_API_BASE_URL=/api/v1
