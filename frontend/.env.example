# Base de la API que usa el frontend (se lee al compilar con Vite).
# Por defecto "/api/v1" (el proxy de desarrollo la reenvía al backend).
# Para un hosting estático separado, usa la URL absoluta del backend.
# No incluyas secretos: todo lo que empieza por VITE_ queda público en el bundle.
VITE_API_BASE_URL=/api/v1
