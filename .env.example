# Copiar a backend/.env — NUNCA subir el archivo .env real al repositorio

# Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
# Modelo vigente en AI Studio (verificar el nombre actual en la documentación oficial)
# Recomendado: gemini-3.5-flash-lite (rápido, 15 peticiones/min en el plan gratuito)
GEMINI_MODEL=
# Modelo de respaldo: los límites son por modelo, así que tiene su propia cuota
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# Aplicación
APP_ENV=development
DATABASE_URL=sqlite:///./storylens.db
CORS_ORIGINS=http://localhost:5173
MAX_STORY_CHARS=10000
MAX_EVIDENCE_MB=1
EVIDENCE_DIR=./storage/evidence
# Topes propios de IA (persistentes). Al agotarse la IA se apaga y la app sigue con las reglas.
AI_REQUESTS_PER_MINUTE=5
AI_DAILY_LIMIT=50

# Cuenta del dueño y sesión (sin estas tres variables solo se ve la demo)
OWNER_EMAIL=
OWNER_PASSWORD=
# Cadena larga y aleatoria, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
# true cuando se sirva por HTTPS
COOKIE_SECURE=false

# Proyecto de demostración de solo lectura y migraciones al arrancar
SEED_DEMO=true
RUN_MIGRATIONS=true

# Frontend: no hace falta configurar nada en desarrollo (el proxy de Vite usa /api/v1).
# VITE_API_BASE_URL (ver frontend/.env.example) solo aplica a una URL absoluta y con ella
# el login del dueño no funciona entre orígenes distintos.
