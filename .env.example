# Copiar a backend/.env — NUNCA subir el archivo .env real al repositorio

# Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
# Modelo vigente en AI Studio (verificar el nombre actual en la documentación oficial)
# Recomendado: gemini-3.5-flash-lite (rápido, 15 peticiones/min en el plan gratuito)
GEMINI_MODEL=
# Modelo de respaldo: los límites son por modelo, así que tiene su propia cuota
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# Aplicación
APP_ENV=development
DATABASE_URL=sqlite:///./storylens.db
CORS_ORIGINS=http://localhost:5173
MAX_STORY_CHARS=10000
MAX_EVIDENCE_MB=5
EVIDENCE_DIR=./storage/evidence
# Topes locales para no agotar la cuota gratuita
AI_REQUESTS_PER_MINUTE=12
AI_DAILY_LIMIT=150

# Frontend (en frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000/api/v1
